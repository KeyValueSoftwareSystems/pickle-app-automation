# Copy to .env (gitignored). Leave PHONE_NUMBER and DEFAULT_OTP blank here and pass them per run:
#   PHONE_NUMBER=+91XXXXXXXXXX DEFAULT_OTP=XXXX .venv/bin/pytest tests/<file>
# Tests that request a real OTP skip unless PHONE_NUMBER is set.
APP_PATH=/path/to/pickle-dev.apk
PLATFORM_NAME=Android
DEVICE_NAME=Pixel_6_API_34
APP_PACKAGE=com.pickleit.app.dev
APPIUM_SERVER=http://127.0.0.1:4723
TIMEOUT_SECONDS=20
DEFAULT_OTP=
PHONE_NUMBER=
